+// ============ FECHAMENTO ======================================================
+// A chamada do fim: "digita QUERO abaixo". O template do edvid só tem headline
+// no COMEÇO (hook), então o card de fim nasce aqui, que é o arquivo que a
+// skill autoriza editar — e continua guiado por dados, não cravado no código.
+//
+// Duas decisões de desenho:
+//   1. A PALAVRA vem antes da frase. Quem assiste sem som precisa ler a palavra
+//      num relance; "digita ... abaixo" é contexto, não é o que se copia.
+//   2. A seta pulsa PRA BAIXO. É ela que diz onde comentar sem gastar palavra,
+//      e o movimento é o que puxa o olho num vídeo que já vai acabar.
+
+type Fechamento = {
+  enabled?: boolean;
+  palavra: string;
+  antes?: string;
+  depois?: string;
+  inicioSec?: number;
+  duracaoSec?: number;
+};
+
+const CartaoFinal: React.FC<Fechamento> = ({
+  palavra, antes = 'digita', depois = 'aqui embaixo', inicioSec, duracaoSec = 3,
+}) => {
+  const {fps, durationInFrames} = useVideoConfig();
+  const dur = Math.round(duracaoSec * fps);
+  // Sem início declarado, encosta no fim do vídeo.
+  const from = inicioSec != null
+    ? Math.round(inicioSec * fps)
+    : Math.max(0, durationInFrames - dur);
+  return (
+    <Sequence from={from} durationInFrames={dur}>
+      <CorpoFinal palavra={palavra} antes={antes} depois={depois} />
+    </Sequence>
+  );
+};
+
+const CorpoFinal: React.FC<{palavra: string; antes: string; depois: string}> = ({
+  palavra, antes, depois,
+}) => {
+  const frame = useCurrentFrame();
+  const {fps} = useVideoConfig();
+
+  const entrada = interpolate(frame, [0, Math.round(0.35 * fps)], [0, 1], {
+    extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.out(Easing.cubic),
+  });
+  const sobe = interpolate(entrada, [0, 1], [40, 0]);
+  // A seta pulsa uma vez por segundo — rápido o bastante pra puxar o olho,
+  // lento o bastante pra não virar tremor.
+  const pulso = Math.sin((frame / fps) * Math.PI * 2) * 10;
+
+  return (
+    <AbsoluteFill style={{
+      justifyContent: 'flex-end', alignItems: 'center',
+      paddingBottom: 300, opacity: entrada,
+    }}>
+      <div style={{
+        transform: `translateY(${sobe}px)`,
+        background: 'rgba(10,16,36,0.94)',
+        borderRadius: 28, padding: '34px 46px 30px',
+        display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 6,
+        boxShadow: '0 18px 60px rgba(0,0,0,0.45)',
+        maxWidth: 880,
+      }}>
+        <span style={{
+          fontFamily, fontWeight: 600, fontSize: 40, color: '#B6B8C8',
+          letterSpacing: '0.02em',
+        }}>{antes}</span>
+        <span style={{
+          fontFamily, fontWeight: 900, fontSize: 132, lineHeight: 1,
+          color: '#FFFFFF', letterSpacing: '-0.02em', textTransform: 'uppercase',
+        }}>{palavra}</span>
+        <span style={{
+          fontFamily, fontWeight: 600, fontSize: 40, color: '#B6B8C8',
+        }}>{depois}</span>
+        <span style={{
+          fontSize: 62, lineHeight: 1, marginTop: 6,
+          transform: `translateY(${pulso}px)`,
+        }}>👇</span>
+      </div>
+    </AbsoluteFill>
+  );
+};
+
