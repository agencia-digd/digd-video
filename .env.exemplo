# dig.D Vídeo — copie para .env e ajuste. Tudo aqui é opcional: sem .env, os
# padrões funcionam quando se segue o README.

# --- Servidor ---------------------------------------------------------------
# Onde escutar. 127.0.0.1 = só esta máquina. Pra abrir na rede, defina
# VIDEOS_TOKEN também (o scripts/rodar.sh recusa subir aberto sem token).
#VIDEOS_HOST=127.0.0.1
#VIDEOS_PORTA=8742

# Token de acesso. Com ele definido, toda rota exige o token: abra uma vez
# http://SEU_HOST:8742/entrar?token=SEU_TOKEN no navegador e ele vira cookie.
# Gere um com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#VIDEOS_TOKEN=

# Tamanho máximo de upload, em MB.
#VIDEOS_TAM_MAX_MB=500

# Só se você chamar a API de OUTRO domínio (um painel seu). Separado por vírgula.
#VIDEOS_ORIGENS=https://painel.exemplo.com
# Link "voltar" no topo do editor. Vazio = sem link.
#VIDEOS_VOLTAR_URL=https://painel.exemplo.com

# --- Pastas -----------------------------------------------------------------
# Onde ficam os vídeos e as referências de estilo. Padrão: ./dados
#VIDEOS_RAIZ=/caminho/para/dados
#VIDEOS_REFERENCIAS=/caminho/para/dados/referencias

# --- edvid (motor de corte e render) ----------------------------------------
# Padrão: ./vendor/edvid, onde o scripts/instalar-edvid.sh instala.
#VIDEOS_EDVID=/caminho/para/edvid
# Template do Remotion (precisa de node_modules). Padrão: $VIDEOS_EDVID/assets/shortform
#VIDEOS_REMOTION=
# Python com o WhisperX. Padrão: $VIDEOS_EDVID/.venv/bin/python
#VIDEOS_PYTHON=
# Idioma da fala, pra transcrição.
#VIDEOS_IDIOMA=pt

# --- Opcionais --------------------------------------------------------------
# IA que sugere quais falas tirar. Usa o Claude Code (`claude -p`), logado na
# sua conta. Sem ele, o corte de silêncio funciona igual; só não vem sugestão.
#VIDEOS_CLAUDE_BIN=/caminho/para/claude
#VIDEOS_IA_MODELO=claude-sonnet-5

# Gerador de imagem pra capa e arte de tela dividida. Sem ele, essas duas
# funções ficam desligadas (a tela avisa). Contrato no README.
#VIDEOS_GERADOR_IMAGEM=/caminho/para/meu-gerador.sh
# Assinatura pequena na capa, ex.: @seuperfil
#VIDEOS_ASSINATURA_CAPA=
